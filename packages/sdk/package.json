{
  "name": "@realmio/sdk",
  "version": "0.1.0",
  "description": "Realmio JavaScript/TypeScript SDK \u2014 admin and tenant auth client",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "types": "./src/index.ts"
    },
    "./admin": {
      "import": "./src/admin/index.js",
      "types": "./src/admin/index.ts"
    },
    "./tenant": {
      "import": "./src/realmio-tenant-auth-client.js",
      "types": "./src/realmio-tenant-auth-client.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "realmio",
    "auth",
    "multi-tenant",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Rndynt/Realmio.git"
  }
}
