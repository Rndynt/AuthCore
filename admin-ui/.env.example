# Admin UI — Environment Variables
# Copy ke .env.production untuk production

# URL publik dari backend API (dipakai saat SSR)
NEXT_PUBLIC_API_URL=https://your-domain.com

# URL internal backend (hanya di Docker, untuk server-side rewrites)
# Dalam Docker compose, ini otomatis diisi via docker-compose.yml
# NEXT_INTERNAL_API_URL=http://api:4000
