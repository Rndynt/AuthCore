# App
PORT=4000
BETTER_AUTH_URL=http://localhost:4000
# PENTING: BETTER_AUTH_SECRET harus minimal 24 karakter!
# Generate dengan: openssl rand -base64 32
BETTER_AUTH_SECRET=changeme-long-random-secret-key-minimum-24-chars

# CORS / Trusted Origins (pisahkan dengan koma)
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4000

# Database (local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/authdb

# Mode operasi: 'single' atau 'multi'
AUTH_MODE=multi

# Untuk AUTH_MODE=single saja:
# TENANT_ID=my-tenant
# TENANT_SCHEMA=public

# Nested tenancy (hanya untuk AUTH_MODE=multi)
NESTED_TENANCY_ENABLED=false

# Dev endpoints (jangan aktifkan di production!)
ENABLE_DEV_ENDPOINTS=false

# Bootstrap tenant registry + Better Auth tables otomatis saat boot (idempotent,
# aman dijalankan berkali-kali). Set true untuk skip (mis. kalau migrasi schema
# dikelola lewat step CI/CD terpisah).
# SKIP_DB_BOOTSTRAP=false

# Optional: Override connection pool settings
# POOL_MAX=20
# POOL_IDLE_TIMEOUT_MS=30000
